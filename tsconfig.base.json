{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2024"
    ],
    "strict": true,
    "noImplicitAny": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "composite": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
