{
  "name": "@sasimoreyang-ai/dsh-llm-agent-hint",
  "version": "0.6.0-rc.1",
  "description": "DSH provider with inherited DeepSeek settings, agent_hint and bounded session lifecycle control over Chat or Messages",
  "type": "module",
  "license": "MIT",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/vendor/**/*.js",
    "lib/vendor/**/*.d.ts",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "README.en.md",
    "examples/*.yml",
    "docs/*.md",
    "cordis.patch.yml",
    "core-patch/CORE-PATCH.md",
    "STANDARDIZATION.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "build": "tsc -b && node scripts/vendor-core.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc -b --force",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && node scripts/check-package.mjs",
    "check:install": "node scripts/check-install.mjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.27",
    "@types/react-test-renderer": "18.3.1",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.11",
    "@sasimoreyang-ai/agenthint-core": "0.6.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasimoreyang-ai/dsh-agenthint.git"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "homepage": "https://github.com/sasimoreyang-ai/dsh-agenthint#readme",
  "bugs": {
    "url": "https://github.com/sasimoreyang-ai/dsh-agenthint/issues"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
